@page "/"

<PageTitle>sevDesk.NET Docs</PageTitle>

<div class="landing-page py-5">
    <div class="text-center mb-5">
        <img src="img/sevDeskNET-logo.svg" alt="sevDesk.NET" width="96" height="96" class="mb-3 landing-hero-logo" />
        <h1 class="display-4 fw-bold">sevDesk.NET</h1>
        <p class="lead text-muted">
            A strongly-typed .NET client library for the sevDesk API.
            Manage invoices, contacts, vouchers, and more with full async support.
        </p>
        <div class="mt-4">
            <a href="docs/getting-started/installation" class="btn btn-primary btn-lg me-2">Get Started</a>
            <a href="api" class="btn btn-outline-primary btn-lg me-2">API Explorer</a>
            <a href="https://github.com/sevDesk-NET/sevDesk.NET" class="btn btn-outline-secondary btn-lg"
               target="_blank" rel="noopener">GitHub</a>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Getting Started</h5>
                    <p class="card-text text-muted">Install the NuGet package, configure your API token, and make your first API call in minutes.</p>
                    <a href="docs/getting-started/installation" class="btn btn-sm btn-outline-primary">Get Started</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">API Explorer</h5>
                    <p class="card-text text-muted">Browse all 20 typed clients with method documentation and interactive Try It panels.</p>
                    <a href="api" class="btn btn-sm btn-outline-primary">Explore API</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Guides</h5>
                    <p class="card-text text-muted">Learn about pagination, error handling, models, and advanced usage patterns.</p>
                    <a href="docs/guides/pagination" class="btn btn-sm btn-outline-primary">Read Guides</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Quick Start</h5>
                    <CodeBlock Language="bash" Code="dotnet add package sevDesk.NET" />
                    <CodeBlock Language="csharp" Code="@_programCs" />
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Usage Example</h5>
                    <CodeBlock Language="csharp" Code="@_usageExample" />
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-4">
        <div class="col-12">
            <h4 class="mb-3">20 Typed Clients</h4>
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-5 g-2">
                @foreach (var client in ClientDefinitions.All)
                {
                    <div class="col">
                        <a href="@client.Href" class="text-decoration-none">
                            <div class="card h-100 service-card">
                                <div class="card-body py-2 px-3">
                                    <small class="fw-semibold">@client.Title</small>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private const string _programCs = """
        builder.Services.AddSevDesk(options =>
        {
            options.ApiToken = "YOUR_API_TOKEN";
        });
        """;

    private const string _usageExample = """
        public class InvoiceService
        {
            private readonly ISevDeskClient _client;

            public InvoiceService(ISevDeskClient client)
            {
                _client = client;
            }

            public async Task ListInvoicesAsync()
            {
                var result = await _client.Invoices.ListAsync();
                foreach (var invoice in result.Items)
                {
                    Console.WriteLine($"{invoice.InvoiceNumber}: {invoice.SumGross}");
                }
            }
        }
        """;
}
