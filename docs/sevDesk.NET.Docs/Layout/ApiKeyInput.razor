@inject DocsApiTokenService TokenService
@inject IJSRuntime JS

<div class="api-key-input d-flex align-items-center gap-2">
    <label for="apiTokenInput" class="text-light text-nowrap mb-0 small">API Token:</label>
    <input id="apiTokenInput"
           type="password"
           placeholder="Enter sevDesk API Token..."
           @bind="_apiToken"
           @bind:event="oninput"
           @onkeydown="OnKeyDown"
           class="form-control form-control-sm"
           style="max-width: 260px;" />
    <button class="btn btn-sm btn-primary text-nowrap" @onclick="ApplyToken" disabled="@string.IsNullOrWhiteSpace(_apiToken)">
        Apply
    </button>
    @if (_applied)
    {
        <span class="badge bg-success">Active</span>
    }
</div>

@code {
    private string? _apiToken;
    private bool _applied;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string?>("sessionStorage.getItem", "sevDeskApiToken");
                if (!string.IsNullOrWhiteSpace(stored))
                {
                    _apiToken = stored;
                    _applied = true;
                    TokenService.UpdateApiToken(stored);
                    StateHasChanged();
                }
            }
            catch { /* unavailable */ }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_apiToken))
            await ApplyToken();
    }

    private async Task ApplyToken()
    {
        if (string.IsNullOrWhiteSpace(_apiToken)) return;

        await JS.InvokeVoidAsync("sessionStorage.setItem", "sevDeskApiToken", _apiToken);
        TokenService.UpdateApiToken(_apiToken);
        _applied = true;
    }
}
