<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>sevDesk.NET</PackageId>
    <Description>Unofficial .NET client library for the sevDesk API. Community project, not affiliated with or endorsed by sevDesk GmbH.</Description>
    <PackageTags>sevdesk;accounting;invoice;voucher;api;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <UseRepoReadmeInPackage>false</UseRepoReadmeInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="sevDesk.NET.Tests" />
  </ItemGroup>

</Project>
